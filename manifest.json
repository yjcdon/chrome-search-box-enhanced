{
  "manifest_version": 3,
  "name": "Chrome Search Box Enhanced",
  "version": "1.0.0",
  "description": "Chrome 原生查找增强插件",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": []
}
